# Firebase Public Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Server side)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# Encryption (Server side) - Required for encrypting GHL API keys at rest
ENCRYPTION_SECRET=your_random_32_char_secret_key

# Development only - Set to "true" to allow unverified JWT fallback (NEVER in production)
# ALLOW_UNVERIFIED_JWT=true

# GHL: No hay credenciales globales. Cada broker conecta su propia subcuenta
# via el Wizard de Onboarding en el Hub (Location ID + Token PIT individual).

# E360 Central CRM - Subcuentas para doble sincronización (Hub-First Intake)
GHL_E360_FINANCIAL_LOCATION_ID=your_financial_location_id
GHL_E360_FINANCIAL_API_KEY=your_financial_pit_token
GHL_E360_INSURANCE_LOCATION_ID=your_insurance_location_id
GHL_E360_INSURANCE_API_KEY=your_insurance_pit_token
