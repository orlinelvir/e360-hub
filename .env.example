# Firebase Public Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Server side)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# Encryption (Server side) - Required for encrypting GHL API keys at rest
ENCRYPTION_SECRET=your_random_32_char_secret_key

# Development only - Set to "true" to allow unverified JWT fallback (NEVER in production)
# ALLOW_UNVERIFIED_JWT=true

# GHL: No hay credenciales globales por broker. Cada broker conecta su propia subcuenta
# via el Wizard de Onboarding en el Hub (Location ID + Token PIT individual).

# E360 Central CRM - Subcuentas para doble sincronización (Hub-First Intake)
GHL_E360_FINANCIAL_LOCATION_ID=your_financial_location_id
GHL_E360_FINANCIAL_API_KEY=your_financial_pit_token
GHL_E360_INSURANCE_LOCATION_ID=your_insurance_location_id
GHL_E360_INSURANCE_API_KEY=your_insurance_pit_token
# Corporativo/Legal: Incorporación, Nómina, POS, Impuestos, Inmigración
GHL_E360_CORPORATE_LOCATION_ID=your_corporate_location_id
GHL_E360_CORPORATE_API_KEY=your_corporate_pit_token

# GHL Agency - Token de agencia (Company-level PIT) usado por /api/admin/locations
# para listar todas las subcuentas de brokers. Requerido solo para el Panel de Admin.
GHL_AGENCY_ID=your_ghl_company_id
GHL_AGENCY_API_KEY=your_agency_pit_token

# Location ID de referencia usada como default en el cliente (opcional)
NEXT_PUBLIC_GHL_DEFAULT_LOCATION_ID=your_default_location_id

# Secreto compartido para autenticar webhooks entrantes desde Workflows de GHL
# (POST /api/webhooks/ghl con header x-webhook-secret). Genera un valor aleatorio largo.
GHL_WEBHOOK_SECRET=your_random_webhook_secret

# Secreto que Vercel Cron inyecta automáticamente como "Authorization: Bearer $CRON_SECRET"
# al invocar /api/cron/*. Ver vercel.json. https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=your_random_cron_secret

# Auto-aprovisionamiento de subcuentas de broker (evento broker_onboarding_form_submitted)
# Snapshot que se clona para crear cada subcuenta nueva ("Master CRM ESP/ENG")
GHL_BROKER_SNAPSHOT_ID=your_snapshot_id
# Location ID donde vive el formulario de Onboarding ("Emprende 360"), usada también
# como default en /api/admin/calendars para listar calendarios sin pasar locationId.
GHL_ONBOARDING_FORM_LOCATION_ID=your_emprende_360_location_id
# Referencia: Location ID de la plantilla base del snapshot ("Master CRM ESP/ENG") — Y4UHMbA40St5o8m7zWs5
