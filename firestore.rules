rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar para verificar roles
    function getRole() {
      return get(/databases/$(database)/documents/brokers/$(request.auth.uid)).data.role;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Campos de brokers/{uid} que solo el backend (Admin SDK, vía rutas API que
    // validan permisos de rol) puede fijar o cambiar — jamás el propio dueño del
    // documento. Sin esto, cualquier broker podía escribir directo por el SDK de
    // cliente (ej. desde la consola del navegador) y auto-otorgarse role:"admin",
    // marcarse packagePaid:true, o inflar referralEarnings, sin pasar por ninguna
    // ruta API. Confirmado que ningún código legítimo depende de escribir estos
    // campos vía cliente — el guardado real de perfil pasa por /api/broker/profile
    // (Admin SDK), que ignora estas reglas.
    function protectedBrokerFields() {
      return ['role', 'tier', 'packagePaid', 'referralEarnings', 'referredByUid', 'onboardingStage', 'ghlConnected', 'totalVolumeProcessed', 'totalCommissionsPaid'];
    }

    // 0. Reglas para la colección de BROKERS & E360 Hub
    match /brokers/{userId} {
      allow read: if isOwner(userId) || (isAuthenticated() && getRole() == 'admin');

      allow create: if (isOwner(userId)
          && (!('role' in request.resource.data) || request.resource.data.role == 'broker')
          && (!('packagePaid' in request.resource.data) || request.resource.data.packagePaid == false)
          && (!('referralEarnings' in request.resource.data) || request.resource.data.referralEarnings == 0))
        || (isAuthenticated() && getRole() == 'admin');

      allow update: if (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedBrokerFields()))
        || (isAuthenticated() && getRole() == 'admin');

      allow delete: if isAuthenticated() && getRole() == 'admin';

      // Notificaciones in-app (broker y staff) — se crean vía Admin SDK desde
      // los mismos disparadores que ya mandan correo (status de caso, nota de
      // broker, solicitud nueva), así que todo el acceso pasa por rutas API.
      match /notifications/{notificationId} {
        allow read, write: if false;
      }

      // Contadores de rate-limit (ej. Chat IA) — solo el backend los lee/escribe.
      match /rateLimits/{key} {
        allow read, write: if false;
      }

      // Clientes y Leads scoped por Broker. "status" y "adminNotes" son
      // exclusivos del staff (vía /api/admin/cases, Admin SDK) — sin esto, un
      // broker podía auto-aprobar su propia solicitud escribiendo
      // status:"approved" directo por el SDK de cliente.
      match /clients/{clientId} {
        allow read: if isOwner(userId) || (isAuthenticated() && getRole() == 'admin');

        allow create: if isOwner(userId) || (isAuthenticated() && getRole() == 'admin');

        allow update: if (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'adminNotes']))
          || (isAuthenticated() && getRole() == 'admin');

        allow delete: if isAuthenticated() && getRole() == 'admin';

        // Caso de Reparación de Crédito: contiene credenciales cifradas de terceros
        // (CRC/MyFreeScoreNow) y últimos 4 SSN. Solo el backend (Admin SDK, que
        // ignora estas reglas) puede escribir; el broker dueño y el admin pueden leer.
        match /creditRepairCase/{caseId} {
          allow read: if isOwner(userId) || (isAuthenticated() && getRole() == 'admin');
          allow write: if false;
        }

        // Rondas mensuales del fee de $10 de Reparación de Crédito
        match /feeRounds/{roundId} {
          allow read: if isOwner(userId) || (isAuthenticated() && getRole() == 'admin');
          allow write: if false;
        }

        // Expediente de caso (Financiamiento/Seguros): notas segmentadas por audiencia
        // (observación y caso son internas para admin/especialista; broker son visibles
        // al broker) y documentos adjuntos. La visibilidad por categoría/rol de vertical
        // no se puede expresar de forma segura en reglas de Firestore, así que todo el
        // acceso (lectura incluida) pasa exclusivamente por rutas API con Admin SDK.
        match /caseNotes/{noteId} {
          allow read, write: if false;
        }

        match /caseDocuments/{docId} {
          allow read, write: if false;
        }
      }

      // Tickets de soporte scoped por Broker (Legacy & Enhanced V2)
      match /tickets/{ticketId} {
        allow read, write: if isOwner(userId) || (isAuthenticated() && getRole() == 'admin');
      }

      match /enhancedTickets/{ticketId}/{allPaths=**} {
        allow read, write: if isOwner(userId) || (isAuthenticated() && getRole() == 'admin');
      }

      // Conversaciones y mensajes con el Asistente IA
      match /supportConversations/{convId}/{allPaths=**} {
        allow read, write: if isOwner(userId) || (isAuthenticated() && getRole() == 'admin');
      }
    }

    // Base de conocimiento pública para brokers autenticados
    match /supportKnowledge/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getRole() == 'admin';
    }

    // 1. Reglas para la colección de USUARIOS
    match /users/{userId} {
      // Cualquier usuario autenticado puede leer su propio perfil
      allow read: if request.auth != null && request.auth.uid == userId;
      // Solo el Admin puede ver la lista de todos los usuarios
      allow list: if request.auth != null && getRole() == 'admin';
      // Solo el Admin puede crear o borrar usuarios (o el sistema vía Admin SDK)
      allow write: if request.auth != null && getRole() == 'admin';
    }

    // 2. Reglas para LEADS (Sincronizados de GHL)
    match /leads/{leadId} {
      // Admin: Acceso total
      allow read, write: if request.auth != null && getRole() == 'admin';
      // Broker: Solo lee/edita los leads que tiene asignados
      allow read, update: if request.auth != null && (getRole() == 'broker' && resource.data.brokerId == request.auth.uid);
      // Cliente: Solo lee su propia información
      allow read: if request.auth != null && (getRole() == 'client' && resource.data.clientId == request.auth.uid);
    }

    // 3. Reglas para KPIs y MÉTRICAS
    match /kpis/{kpiId} {
      allow read: if request.auth != null && (
        getRole() == 'admin' ||
        (getRole() == 'broker' && resource.data.uid == request.auth.uid)
      );
      // Solo el Admin o procesos automáticos (Make.com) escriben KPIs
      allow write: if request.auth != null && getRole() == 'admin';
    }

    // 4. Auditoría de subcuentas GHL auto-aprovisionadas desde el Snapshot
    // (solo el webhook, vía Admin SDK, escribe aquí; admin lee para auditar)
    match /provisionedSubaccounts/{docId} {
      allow read: if request.auth != null && getRole() == 'admin';
      allow write: if false;
    }

    // 5. Overrides de contenido del catálogo de servicios (precio, requisitos,
    // etc.) — la lectura pública real pasa por /api/services/overrides
    // (Admin SDK) para que cualquier broker autenticado la use sin necesitar
    // permisos especiales; la escritura pasa por /api/admin/services, que sí
    // valida el permiso manage_services. Todo por Admin SDK, nada por cliente.
    match /serviceOverrides/{serviceId} {
      allow read, write: if false;
    }
  }
}
